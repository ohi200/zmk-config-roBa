#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

// #includeのあとのあたりにスクロール量変更の定義を追記

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&trackball {
    automouse-layer = <0>;
    scroll-layers = <7>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 2 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

   

    keymap {
        compatible = "zmk,keymap";

        MOUSE {
            bindings = <
&kp ESC                &kp END       &kp UP_ARROW    &kp HOME     &kp F2                                  &kp RA(LEFT_ARROW)  &kp LC(LEFT)     &kp PAGE_DOWN      &kp PAGE_UP  &kp LC(W)
&mt LS(LCTRL) LS(TAB)  &kp LEFT      &kp DOWN_ARROW  &kp RIGHT    &kp TAB      &trans      &trans         &kp HOME            &mkp LCLK        &mkp MB3           &mkp MB2     &mt RIGHT_SHIFT ENTER
&kp LEFT_SHIFT         &kp F11       &trans          &trans       &trans       &to 1       &to 1          &kp LC(L)           &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp END      &trans
&kp LCTRL              &kp LEFT_GUI  &kp LEFT_ALT    &lt 6 LANG5  &lt 4 SPACE  &to 4       &kp BACKSPACE  &lt 1 SPACE                                                          &kp DEL
            >;
        };

        WIN {
            bindings = <
&mt ESC Q           &kp W         &kp E         &kp R             &kp T                                            &kp Y        &kp U    &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S         &kp D         &lt 5 F           &lt 0 G      &to 0        &mt EXCLAMATION TILDE  &kp H        &lt 5 J  &kp K      &kp L    &mt RIGHT_SHIFT RET
&mt LEFT_SHIFT Z    &kp X         &kp C         &kp V             &kp B        &to 5        &to 4                  &kp N        &kp M    &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL           &kp LEFT_GUI  &kp LEFT_ALT  &lt 6 LANGUAGE_5  &lt 4 SPACE  &kp TAB      &kp BACKSPACE          &lt 4 SPACE                               &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        MAC {
            bindings = <
&mt ESC Q           &kp W         &kp E                        &kp R             &kp T                                              &kp Y        &kp U    &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S         &kp D                        &lt 5 F           &lt 0 G      &mkp MCLK      &mt EXCLAMATION TILDE  &kp H        &lt 5 J  &kp K      &kp L    &mt RCTRL RET
&mt LEFT_SHIFT Z    &kp X         &kp C                        &kp V             &kp B        &tog 4         &to 4                  &kp N        &kp M    &kp COMMA  &kp DOT  &kp UNDERSCORE
&kp LCTRL           &kp LEFT_ALT  &mt LEFT_COMMAND LANGUAGE_2  &lt 6 LANGUAGE_1  &lt 4 SPACE  &kp TAB        &kp BACKSPACE          &lt 4 SPACE                               &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        ipad {
            bindings = <
&mt ESC Q           &kp W         &kp E                        &kp R             &kp T                                              &kp Y        &kp U    &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S         &kp D                        &lt 5 F           &kp G        &mkp MCLK      &mt EXCLAMATION TILDE  &kp H        &lt 5 J  &kp K      &kp L    &mt RCTRL RET
&mt LEFT_SHIFT Z    &kp X         &kp C                        &kp V             &kp B        &tog 4         &to 5                  &kp N        &kp M    &kp COMMA  &kp DOT  &kp UNDERSCORE
&kp LCTRL           &kp LEFT_ALT  &mt LEFT_COMMAND LANGUAGE_2  &lt 6 LANGUAGE_1  &lt 4 SPACE  &kp TAB        &kp BACKSPACE          &lt 4 SPACE                               &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUMBER {
            bindings = <
&kp EXCLAMATION              &kp DOUBLE_QUOTES  &kp HASH           &kp DOLLAR     &kp PERCENT                             &kp LS(NUMBER_6)  &kp LS(N7)         &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp MINUS
&kp NUMBER_1                 &kp NUMBER_2       &kp NUMBER_3       &kp NUMBER_4   &kp N5       &trans      &kp NUMBER_6   &kp N7            &kp N8             &kp N9                &kp N0                 &kp RET
&mt LEFT_SHIFT LEFT_BRACKET  &kp PIPE           &kp RIGHT_BRACKET  &kp BACKSLASH  &kp PERCENT  &to 1       &kp LS(MINUS)  &kp COLON         &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON
&trans                       &trans             &trans             &trans         &trans       &trans      &trans         &trans                                                                            &mt DEL SINGLE_QUOTE
            >;
        };

        ARROW {
            bindings = <
&kp ESC         &kp END   &kp UP_ARROW  &kp HOME   &kp F2                       &kp F2   &kp HOME        &kp UP_ARROW    &kp END    &trans
&kp RS(TAB)     &kp LEFT  &kp DOWN      &kp RIGHT  &kp TAB  &trans      &trans  &kp TAB  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp RS(TAB)
&kp LEFT_SHIFT  &kp F11   &trans        &trans     &trans   &to 1       &to 1   &trans   &trans          &trans          &trans     &trans
&trans          &trans    &trans        &trans     &trans   &trans      &trans  &trans                                              &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
